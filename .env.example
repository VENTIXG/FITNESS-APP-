# ─────────────────────────────────────────────────────────────────────────────
# FORGE environment. Copy to `.env` (never commit real values).
# Only variables prefixed NEXT_PUBLIC_ are exposed to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection (required). Works with local Postgres, Supabase, Neon, Railway…
DATABASE_URL=postgres://postgres:postgres@localhost:5432/forge
# "require" for hosted databases that need TLS (Supabase/Neon), "disable" for local.
# DATABASE_SSL=require
# Set to "false" when connecting through a transaction-mode pooler (Supabase :6543, PgBouncer).
# DATABASE_PREPARE=false
# DATABASE_POOL_MAX=10

# Public URL of the deployment (used for push notifications and absolute links).
APP_URL=http://localhost:3000

# Display name of the app (rename the product here).
NEXT_PUBLIC_APP_NAME=FORGE

# Sign-up policy. The first account can always be created; after that sign-up is
# closed unless this is "true" (keep it closed for a private, single-user app).
ALLOW_SIGNUP=false

# Session lifetime in days (sliding).
SESSION_MAX_AGE_DAYS=30

# ── Optional integrations ───────────────────────────────────────────────────

# Open Food Facts barcode / product search (free, no key). Set to "false" to disable
# all outbound food-database requests.
OPENFOODFACTS_ENABLED=true

# Web Push reminders. Generate keys with `pnpm vapid:generate`.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# Shared secret for the reminder cron endpoint (/api/cron/reminders).
# CRON_SECRET=

# AI coach narrative (optional). Without a key the coach uses the built-in
# rule-based engine only. Your data is only sent when you press "Generate".
# ANTHROPIC_API_KEY=
# AI_COACH_MODEL=claude-opus-5-5
